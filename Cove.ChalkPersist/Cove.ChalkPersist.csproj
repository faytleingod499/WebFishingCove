<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- bundled into the dll so the plugin is a single file, this is how Cove finds its name and id -->
    <EmbeddedResource Include="plugin.cfg"></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false keeps Cove.dll out of this plugin's output, the running server already has it -->
    <ProjectReference Include="..\Cove\Cove.csproj">
      <Private>False</Private>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemGroup>

</Project>
